# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids. The name stays ADMIN_CHAT_IDS.
# In a private chat the user id equals the chat id.
ADMIN_CHAT_IDS=
MINI_APP_URL=https://your-mini-app.example.com
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
ACCESS_STATE_FILE=user_access.json
USER_REGISTRY_FILE=users.json

# Trial and subscription
FREE_TRIAL_SIGNALS=5
FREE_TRIAL_COOLDOWN_MINUTES=30
SUBSCRIPTION_PRICE_USDT=29.99
SUBSCRIPTION_DAYS=30
REFERRAL_SUBSCRIPTION_PRICE_USDT=10.00
BINGX_REFERRAL_CODE=D8PYH62T
BINGX_REFERRAL_URL=https://bingx.com/invite/D8PYH62T/
# Separate Agent credentials. Keep this key read-only: no trading, transfers,
# or withdrawals. These variables are used only for direct-referral checks.
BINGX_AGENT_API_KEY=
BINGX_AGENT_API_SECRET=
BINGX_AGENT_API_BASE=https://open-api.bingx.com

# USDT TRC20 payment verification
USDT_PAYMENT_ADDRESS=
USDT_PAYMENT_NETWORK=TRC20
TRONGRID_API_KEY=

# BingX. API credentials are optional and never used by public market scans.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_LISTING_CHECK_INTERVAL=600
BINGX_LISTING_SNAPSHOT_FILE=bingx_markets_snapshot.json
BINGX_ANNOUNCEMENTS_SNAPSHOT_FILE=bingx_announcements_snapshot.json
BINGX_MIN_REQUEST_INTERVAL=1.0
BINGX_MAX_ATTEMPTS=4
BINGX_SNAPSHOT_MAX_STALE_SECONDS=7200
BINGX_TICKER_CACHE_TTL_SECONDS=60
BINGX_CONTRACT_CACHE_TTL_SECONDS=3600

# Scanner and signal quality
MAJOR_SCAN_MIN_CONFIDENCE=0.50
SMART_SPIKE_MIN_SCORE=65
SMART_SPIKE_MIN_QUOTE_VOLUME=500000
SIGNAL_DEDUP_HOURS=4
SIGNAL_HARD_COOLDOWN_MINUTES=30
SIGNAL_LEVEL_TOLERANCE_PCT=1.5

# Mini App local demo. Demo data is used only when Telegram initData is empty.
# A valid Telegram session with no DATABASE_URL returns HTTP 503.
DEMO_USER_ID=10001
MINI_APP_DEMO_MODE=false
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# Required to read GET /metrics. Send Authorization: Bearer <token> or X-Metrics-Token.
METRICS_TOKEN=
